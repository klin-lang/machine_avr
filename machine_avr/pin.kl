// megaAVR Pin (MMIO). ATmega328P + ATmega2560 — classic PORTx/DDRx/PINx.
// Memory addresses match avr-libc (iom328p / iomxx0_1). No hidden init.
module machine_avr

// ATmega328P ports (Uno / Nano / Pro Mini).
pub enum Port: i32 {
    B = 0
    C = 1
    D = 2
}

// ATmega2560 ports (Arduino Mega).
pub enum Port2560: i32 {
    A = 0
    B = 1
    C = 2
    D = 3
    E = 4
    F = 5
    G = 6
    H = 7
    J = 8
    K = 9
    L = 10
}

pub struct Pin {
    port: *mut volatile u8
    pin: *mut volatile u8
    mask: u8
}

// 1 << num for pins 0..7 (no i32→u8 cast in Klin MVP).
fn pin_bit_mask(num: i32): u8 {
    if num == 0 { return 1 }
    if num == 1 { return 2 }
    if num == 2 { return 4 }
    if num == 3 { return 8 }
    if num == 4 { return 16 }
    if num == 5 { return 32 }
    if num == 6 { return 64 }
    return 128
}

// PIN register base for 328P: B@0x23, C@0x26, D@0x29 (DDR=+1, PORT=+2).
fn pin_base_328(port: Port): i32 {
    return 0x23 + cast(i32, port) * 3
}

// PIN register base for 2560: A–G @ 0x20+3n; H/J/K/L @ 0x100+3(n-7).
fn pin_base_2560(port: Port2560): i32 {
    let p = cast(i32, port)
    if p <= 6 {
        return 0x20 + p * 3
    }
    return 0x100 + (p - 7) * 3
}

fn make_pin(base: i32, num: i32, as_output: i32): Pin {
    let mask = pin_bit_mask(num)
    let pin = cast(*mut volatile u8, base)
    let ddr = cast(*mut volatile u8, base + 1)
    let port = cast(*mut volatile u8, base + 2)
    if as_output != 0 {
        *ddr = *ddr | mask
    } else {
        let inv: u8 = mask ^ 255
        *ddr = *ddr & inv
    }
    return Pin{ port: port, pin: pin, mask: mask }
}

// ATmega328P — configure port/num as output. Pins 0..7 (PORTC: 0..6).
pub fn pin_out(port: Port, num: i32): Pin {
    return make_pin(pin_base_328(port), num, 1)
}

// ATmega328P — configure port/num as input.
pub fn pin_in(port: Port, num: i32): Pin {
    return make_pin(pin_base_328(port), num, 0)
}

// ATmega2560 — configure port/num as output.
pub fn pin_out_2560(port: Port2560, num: i32): Pin {
    return make_pin(pin_base_2560(port), num, 1)
}

// ATmega2560 — configure port/num as input.
pub fn pin_in_2560(port: Port2560, num: i32): Pin {
    return make_pin(pin_base_2560(port), num, 0)
}

pub fn (p: Pin) high() {
    *(p.port) = *(p.port) | p.mask
}

pub fn (p: Pin) low() {
    let inv: u8 = p.mask ^ 255
    *(p.port) = *(p.port) & inv
}

// Writing 1 to PINx toggles the corresponding PORTx bit (megaAVR).
pub fn (p: Pin) toggle() {
    *(p.pin) = p.mask
}

pub fn (p: Pin) set(v: i32) {
    if v != 0 {
        p.high()
    } else {
        p.low()
    }
}

pub fn (p: Pin) value(): i32 {
    if (*(p.pin) & p.mask) != 0 {
        return 1
    }
    return 0
}
